// Тест поддержки русского языка: идентификаторы и строки в кодировке UTF-8
// Русские имена функций, переменных, аргументов; латиница и кириллица в одном имени

extern printf

глобальная_счётчик;

привет(имя) {
    printf("Привет, %s!\n", имя);
}

сумма(а, б) {
    return а + б;
}

global main
main() {
    auto результат;
    auto i;
    результат = сумма(2, 3);
    привет("мир");
    printf("сумма = %d\n", результат);
    глобальная_счётчик = 7;
    printf("глобальная = %d\n", глобальная_счётчик);
    i = 0;
    while i < 3 {
        printf("итерация %d, mixed_имя_%d\n", i, i);
        i = i + 1;
    }
    0;
}
